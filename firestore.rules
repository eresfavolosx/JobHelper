rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // --- Existing Shared Project Collections (NovuJobs / jobhelper-c3cd7) ---
    //
    // Collection: /users/{userId}/data/profile (single document 'profile')
    // Document ID: 'profile'
    // Fields:
    //   - fullName: string (optional, 0..100 chars) - User's full name
    //   - targetRole: string (optional, 0..100 chars) - Desired job role/title
    //   - location: string (optional, 0..200 chars) - User's home location
    //   - keywords: string (optional, 0..1000 chars) - Comma-separated search keywords
    //   - isRemote: bool (optional) - Remote work preference
    //   - experienceLevel: string or list (optional, 0..250 chars or max 10 items) - Experience level(s)
    //   - country: string (optional, 0..100 chars) - User country
    //   - modality: string or list (optional, 0..250 chars or max 10 items) - Work modality (Remote, Hybrid, On-site)
    //   - minimumSalary: string/int/number/null (optional, 0..50 chars if string) - Desired minimum salary
    //   - contextDocuments: list (optional, max 20 items) - Uploaded resume/context documents
    //   - resumeAnalysis: map or null (optional, max 50 keys) - AI-extracted resume analysis
    //   - geminiApiKey: string (optional, 0..200 chars) - User-provided Gemini API key
    //   - claudeApiKey: string (optional, 0..200 chars) - User-provided Claude API key
    //   - openaiApiKey: string (optional, 0..200 chars) - User-provided OpenAI API key
    //   - customAiApiKey: string (optional, 0..200 chars) - User-provided custom AI API key
    //   - customAiBaseUrl: string (optional, 0..250 chars) - Custom AI base URL
    //   - customAiModel: string (optional, 0..100 chars) - Custom AI model name
    //   - activeAiProvider: string (optional, in ['gemini', 'claude', 'openai', 'custom']) - Selected active AI provider
    //   - googleMapsApiKey: string (optional, 0..200 chars) - User-provided Google Maps API key
    //   - subscriptionStatus: string (optional, in ['free', 'premium', 'trial']) - Subscription status
    //   - trialStartDate: string/timestamp/null (optional, 0..100 chars) - Trial start date
    //   - trialEndDate: string/timestamp/null (optional, 0..100 chars) - Trial end date
    //   - applicationGoal: map or null (optional, max 10 keys) - Goal tracking settings (target, cadence, targetRole, hoursPerWeek, reminderEnabled, enabled, startDate, updatedAt)
    //   - security2FA: map or null (optional, max 4 keys: enabled, secret, backupCodes, enabledAt) - Two-factor authentication configuration
    //   - updatedAt: string/timestamp/null (optional, 0..100 chars) - Last updated timestamp
    //
    // Collection: /users/{userId}/data/cycles (single document 'cycles')
    // Document ID: 'cycles'
    // Fields: User search cycles data
    //
    // Collection: /users/{userId}/jobs/{jobId}
    // Document ID: {jobId} (string, 1..100 chars)
    // Fields:
    //   - id: string (optional, 1..100 chars, immutable) - Must match {jobId} if present
    //   - company: string (optional, 0..200 chars) - Company name
    //   - role: string (optional, 0..200 chars) - Job title/role
    //   - title: string (optional, 0..200 chars) - Alias for job title
    //   - location: string (optional, 0..200 chars) - Job location
    //   - status: string (required, in ['wishlist', 'applied', 'screening', 'interviewing', 'offer', 'accepted', 'rejected', 'archived', 'deleted'])
    //   - url: string (optional, 0..2048 chars) - Job URL
    //   - link: string (optional, 0..2048 chars) - Alias for job URL
    //   - description: string (optional, 0..200000 chars) - Job description text
    //   - salary: string (optional, 0..100 chars) - Salary range
    //   - notes: string (optional, 0..10000 chars) - Notes or AI match info
    //   - commuteTime: string (optional, 0..200 chars) - Calculated commute time
    //   - relevanceScore: int/float (optional, 0..100) - AI relevance score percentage
    //   - matchReason: string (optional, 0..2000 chars) - AI match reasoning
    //   - createdAt: string/timestamp (optional, 0..100 chars, immutable) - Creation timestamp
    //   - dateAdded: string/timestamp (optional, 0..100 chars, immutable) - Alias creation timestamp
    //   - updatedAt: string/timestamp/null (optional, 0..100 chars) - Last updated timestamp
    //   - appliedAt: string/timestamp/null (optional, 0..100 chars) - Application date/timestamp
    //   - deletedAt: string/timestamp/number/null (optional, 0..100 chars) - Deletion timestamp
    //   - archivedAt: string/timestamp/number/null (optional, 0..100 chars) - Archive timestamp
    //   - previousStatus: string (optional, in ['wishlist', 'applied', 'screening', 'interviewing', 'offer', 'accepted', 'rejected', 'archived'])
    //   - source: string (optional, 0..100 chars) - Job source (e.g. RSS feed name)
    //   - pubDate: string (optional, 0..100 chars) - Publication date
    //   - tags: list or null (optional, max 25 items) - Job tags
    //   - resumeUrl: string (optional, 0..2048 chars) - Resume download URL
    //   - resumeName: string (optional, 0..200 chars) - Resume file name
    //   - cycleId: string (optional, 0..100 chars) - Associated search cycle ID
    //   - cycleNumber: int (optional) - Associated search cycle sequence number
    //   - followUps: list (optional, max 100 items) - Follow-up history / notes
    //   - lastFollowUpAt: string/timestamp/null (optional, 0..100 chars) - Last follow-up timestamp
    //   - lastInteraction: string/timestamp/null (optional, 0..100 chars) - Last interaction date/timestamp
    //
    // --- CTRL Orange Collections ---
    //
    // Collection: /remote_sessions/{sessionId}
    // Document ID: {sessionId} (uppercase alphanumeric, 6-12 chars: ^[A-Z0-9]{6,12}$)
    // Purpose: Real-time Desktop <-> Phone Mobile Mirror pairing state (no login required,
    //          collection listing disabled so pairing codes cannot be enumerated).
    // Fields:
    //   - sessionId: string (required, immutable, must match document ID {sessionId})
    //   - updatedAt: number (required, epoch ms >= 0 and <= 9999999999999)
    //   - activeMode: string (required, enum: 'ask' | 'followup' | 'livecoach' | 'debrief')
    //   - isStreaming: bool (required)
    //   - isListening: bool (required)
    //   - stealth: map (required, exact keys: contentProtection, alwaysOnTop, hideFromDock,
    //              skipTaskbar, clickThrough, mobileOnlyHidden, focusSafePassive [all bool],
    //              opacity [number 0..1], processTitle [string 0..120])
    //   - activeProvider: string (required, length 0..64)
    //   - activeModel: string (required, length 0..120)
    //   - bufferSummary: list (required, max 30 items; each item map with exact keys:
    //                    id [string 1..128], type ['screenshot'|'text'|'audio'|'code'],
    //                    label [string 0..200], preview [string 0..2000], createdAt [number])
    //   - latestResponse: string (required, length 0..200000)
    //   - messages: list (required, max 100 items; each item map with required keys:
    //               id [string 1..128], role ['user'|'assistant'],
    //               mode ['ask'|'followup'|'livecoach'|'debrief'], content [string 0..200000],
    //               timestamp [number], and optional key: providerUsed [string 0..120])
    //   - liveTranscript: string (required, length 0..100000)
    //   - debriefReport: string (required, length 0..200000)
    //
    // Subcollection: /remote_sessions/{sessionId}/commands/{commandId}
    // Document ID: {commandId} (1..128 chars)
    // Purpose: Append-only remote control commands sent from Phone Remote to Desktop.
    // Fields:
    //   - id: string (required, length 1..128)
    //   - type: string (required, enum: CAPTURE_SCREENSHOT, CAPTURE_CLIPBOARD, TOGGLE_AUDIO,
    //           ASK_AI, FOLLOW_UP, LIVE_COACH, DEBRIEF, HIDE_DESKTOP, TOGGLE_GHOST_MODE,
    //           CLEAR_BUFFER, SWITCH_MODEL)
    //   - payload: string (optional, length 0..4000)
    //   - createdAt: number (required, epoch ms >= 0 and <= 9999999999999)
    //
    // Collection: /platform_debriefs/{debriefId}
    // Document ID: {debriefId} (1..128 chars)
    // Purpose: Authenticated user-owned post-session debrief records synced to Firebase.
    // Fields:
    //   - userId: string (required, immutable, must equal request.auth.uid)
    //   - sessionTag: string (required, length 0..120)
    //   - reportMarkdown: string (required, length 1..200000)
    //   - createdAt: number (required, immutable, epoch ms >= 0 and <= 9999999999999)
    //
    // ===============================================================

    // Default deny for all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- NovuJobs Helpers ---

    function isPlatformAdmin() {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             request.auth.token.email == 'fabian.velez1996@gmail.com';
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is string &&
              data[field].size() >= minLen &&
              data[field].size() <= maxLen);
    }

    function isValidDateOrTimestamp(data, field) {
      return !(field in data) ||
             data[field] == null ||
             data[field] is timestamp ||
             (data[field] is string && data[field].size() <= 100);
    }

    function isValidDeletedAt(data) {
      return !('deletedAt' in data) ||
             data.deletedAt == null ||
             data.deletedAt is timestamp ||
             data.deletedAt is number ||
             (data.deletedAt is string && data.deletedAt.size() <= 100);
    }

    // --- CTRL Orange Helpers ---

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isBoundedString(value, minLen, maxLen) {
      return value is string &&
        value.size() >= minLen &&
        value.size() <= maxLen;
    }

    function isValidList(listVal, maxSize) {
      return listVal is list && listVal.size() <= maxSize;
    }

    function isValidMapKeys(mapData, requiredKeys, allowedKeys) {
      return mapData is map &&
        mapData.keys().hasAll(requiredKeys) &&
        mapData.keys().hasOnly(allowedKeys);
    }

    function isValidEpochMs(value) {
      return value is number &&
        value >= 0 &&
        value <= 9999999999999;
    }

    function isValidSessionId(sessionId) {
      return sessionId is string &&
        sessionId.size() >= 6 &&
        sessionId.size() <= 12 &&
        sessionId.matches('^[A-Z0-9]{6,12}$');
    }

    function isValidAIMode(mode) {
      return mode is string &&
        mode in ['ask', 'followup', 'livecoach', 'debrief'];
    }

    // ===============================================================
    // Domain Validators — NovuJobs (Existing Shared Project)
    // ===============================================================

    // Validator for /users/{userId}/data/profile applicationGoal map
    function isValidApplicationGoal(goal) {
      return goal is map &&
             goal.keys().size() <= 10 &&
             goal.keys().hasOnly([
               'target', 'cadence', 'targetRole', 'hoursPerWeek',
               'reminderEnabled', 'enabled', 'startDate', 'updatedAt'
             ]) &&
             ('target' in goal &&
              (goal.target is int || goal.target is number) &&
              goal.target >= 1 && goal.target <= 1000) &&
             ('cadence' in goal && goal.cadence is string && goal.cadence in ['daily', 'weekly', 'monthly', 'total']) &&
             isValidOptionalString(goal, 'targetRole', 0, 100) &&
             (!('hoursPerWeek' in goal) ||
              ((goal.hoursPerWeek is int || goal.hoursPerWeek is number) &&
               goal.hoursPerWeek >= 0 && goal.hoursPerWeek <= 168)) &&
             (!('reminderEnabled' in goal) || goal.reminderEnabled is bool) &&
             (!('enabled' in goal) || goal.enabled is bool) &&
             isValidDateOrTimestamp(goal, 'startDate') &&
             isValidDateOrTimestamp(goal, 'updatedAt');
    }

    // Validator for /users/{userId}/data/profile security2FA map
    function isValidSecurity2FA(sec) {
      return sec == null ||
             (sec is map &&
              sec.keys().size() <= 4 &&
              sec.keys().hasOnly(['enabled', 'secret', 'backupCodes', 'enabledAt']) &&
              (!('enabled' in sec) || sec.enabled is bool) &&
              isValidOptionalString(sec, 'secret', 0, 128) &&
              (!('backupCodes' in sec) || (sec.backupCodes is list && sec.backupCodes.size() <= 16)) &&
              isValidDateOrTimestamp(sec, 'enabledAt'));
    }

    // Validator for /users/{userId}/data/profile
    function isValidProfile(data) {
      return data.keys().hasOnly([
               'fullName', 'targetRole', 'location', 'keywords', 'isRemote',
               'experienceLevel', 'country', 'modality', 'minimumSalary',
               'contextDocuments', 'resumeAnalysis', 'geminiApiKey',
               'claudeApiKey', 'openaiApiKey', 'customAiApiKey',
               'customAiBaseUrl', 'customAiModel', 'activeAiProvider',
               'googleMapsApiKey', 'subscriptionStatus', 'trialStartDate', 'trialEndDate',
               'applicationGoal', 'updatedAt', 'security2FA'
             ]) &&
             isValidOptionalString(data, 'fullName', 0, 100) &&
             isValidOptionalString(data, 'targetRole', 0, 100) &&
             isValidOptionalString(data, 'location', 0, 200) &&
             isValidOptionalString(data, 'keywords', 0, 1000) &&
             (!('isRemote' in data) || data.isRemote is bool) &&
             (isValidOptionalString(data, 'experienceLevel', 0, 250) ||
              (data.experienceLevel is list && data.experienceLevel.size() <= 10)) &&
             isValidOptionalString(data, 'country', 0, 100) &&
             (isValidOptionalString(data, 'modality', 0, 250) ||
              (data.modality is list && data.modality.size() <= 10)) &&
             (isValidOptionalString(data, 'minimumSalary', 0, 50) ||
              data.minimumSalary is int ||
              data.minimumSalary is number) &&
             isValidOptionalString(data, 'geminiApiKey', 0, 200) &&
             isValidOptionalString(data, 'claudeApiKey', 0, 200) &&
             isValidOptionalString(data, 'openaiApiKey', 0, 200) &&
             isValidOptionalString(data, 'customAiApiKey', 0, 200) &&
             isValidOptionalString(data, 'customAiBaseUrl', 0, 250) &&
             isValidOptionalString(data, 'customAiModel', 0, 100) &&
             (!('activeAiProvider' in data) ||
              (data.activeAiProvider is string && data.activeAiProvider in ['gemini', 'claude', 'openai', 'custom'])) &&
             isValidOptionalString(data, 'googleMapsApiKey', 0, 200) &&
             (!('subscriptionStatus' in data) ||
              (data.subscriptionStatus is string && data.subscriptionStatus in ['free', 'premium', 'trial'])) &&
             isValidDateOrTimestamp(data, 'trialStartDate') &&
             isValidDateOrTimestamp(data, 'trialEndDate') &&
             isValidDateOrTimestamp(data, 'updatedAt') &&
             (!('contextDocuments' in data) ||
              (data.contextDocuments is list && data.contextDocuments.size() <= 20)) &&
             (!('resumeAnalysis' in data) ||
              data.resumeAnalysis == null ||
              (data.resumeAnalysis is map && data.resumeAnalysis.keys().size() <= 50)) &&
             (!('applicationGoal' in data) ||
              data.applicationGoal == null ||
              isValidApplicationGoal(data.applicationGoal)) &&
             (!('security2FA' in data) ||
              isValidSecurity2FA(data.security2FA));
    }

    // RBAC: Profile privilege escalation protection
    function canCreateProfile(data) {
      return !('subscriptionStatus' in data) ||
             data.subscriptionStatus in ['free', 'trial'] ||
             isPlatformAdmin();
    }

    function canUpdateProfile(data) {
      return !('subscriptionStatus' in data) ||
             data.subscriptionStatus in ['free', 'premium', 'trial'] ||
             isPlatformAdmin();
    }

    // Validator for /users/{userId}/jobs/{jobId}
    function isValidJob(data, jobId) {
      return data.keys().hasOnly([
               'id', 'role', 'title', 'company', 'location', 'salary',
               'url', 'link', 'description', 'notes', 'commuteTime',
               'relevanceScore', 'matchReason', 'status', 'createdAt',
               'dateAdded', 'updatedAt', 'appliedAt', 'deletedAt', 'archivedAt',
               'previousStatus', 'source', 'pubDate', 'tags',
               'resumeUrl', 'resumeName',
               'cycleId', 'cycleNumber', 'followUps', 'lastFollowUpAt', 'lastInteraction'
             ]) &&
             ('status' in data &&
              data.status is string &&
              data.status in ['wishlist', 'applied', 'screening', 'interviewing', 'offer', 'accepted', 'rejected', 'archived', 'deleted']) &&
             (!('previousStatus' in data) ||
              data.previousStatus == null ||
              (data.previousStatus is string &&
               data.previousStatus in ['wishlist', 'applied', 'screening', 'interviewing', 'offer', 'accepted', 'rejected', 'archived'])) &&
             (!('id' in data) ||
              (data.id is string && data.id.size() >= 1 && data.id.size() <= 100 && data.id == jobId)) &&
             isValidOptionalString(data, 'role', 0, 200) &&
             isValidOptionalString(data, 'title', 0, 200) &&
             isValidOptionalString(data, 'company', 0, 200) &&
             isValidOptionalString(data, 'location', 0, 200) &&
             isValidOptionalString(data, 'salary', 0, 100) &&
             isValidOptionalString(data, 'url', 0, 2048) &&
             isValidOptionalString(data, 'link', 0, 2048) &&
             isValidOptionalString(data, 'description', 0, 200000) &&
             isValidOptionalString(data, 'notes', 0, 10000) &&
             isValidOptionalString(data, 'commuteTime', 0, 200) &&
             isValidOptionalString(data, 'matchReason', 0, 2000) &&
             isValidOptionalString(data, 'source', 0, 100) &&
             isValidOptionalString(data, 'pubDate', 0, 100) &&
             isValidOptionalString(data, 'resumeUrl', 0, 2048) &&
             isValidOptionalString(data, 'resumeName', 0, 200) &&
             isValidOptionalString(data, 'cycleId', 0, 100) &&
             (!('cycleNumber' in data) || data.cycleNumber is int) &&
             isValidDateOrTimestamp(data, 'createdAt') &&
             isValidDateOrTimestamp(data, 'dateAdded') &&
             isValidDateOrTimestamp(data, 'updatedAt') &&
             isValidDateOrTimestamp(data, 'appliedAt') &&
             isValidDateOrTimestamp(data, 'lastFollowUpAt') &&
             isValidDateOrTimestamp(data, 'lastInteraction') &&
             isValidDeletedAt(data) &&
             (isValidDateOrTimestamp(data, 'archivedAt') || data.archivedAt is number) &&
             (!('tags' in data) ||
              data.tags == null ||
              (data.tags is list && data.tags.size() <= 25)) &&
             (!('followUps' in data) ||
              data.followUps == null ||
              (data.followUps is list && data.followUps.size() <= 100)) &&
             (!('relevanceScore' in data) ||
              ((data.relevanceScore is int || data.relevanceScore is float) &&
               data.relevanceScore >= 0 && data.relevanceScore <= 100));
    }

    // Protect immutable job fields on update
    function isJobUpdateImmutable(current, incoming) {
      return (!('id' in current) || (('id' in incoming) && incoming.id == current.id)) &&
             (!('createdAt' in current) || (('createdAt' in incoming) && incoming.createdAt == current.createdAt)) &&
             (!('dateAdded' in current) || (('dateAdded' in incoming) && incoming.dateAdded == current.dateAdded));
    }

    // ===============================================================
    // Domain Validators — CTRL Orange
    // ===============================================================

    function isValidStealthConfig(stealth) {
      let stealthKeys = [
        'contentProtection',
        'alwaysOnTop',
        'hideFromDock',
        'skipTaskbar',
        'clickThrough',
        'mobileOnlyHidden',
        'focusSafePassive',
        'opacity',
        'processTitle'
      ];
      return isValidMapKeys(stealth, stealthKeys, stealthKeys) &&
        stealth.contentProtection is bool &&
        stealth.alwaysOnTop is bool &&
        stealth.hideFromDock is bool &&
        stealth.skipTaskbar is bool &&
        stealth.clickThrough is bool &&
        stealth.mobileOnlyHidden is bool &&
        stealth.focusSafePassive is bool &&
        stealth.opacity is number &&
        stealth.opacity >= 0 &&
        stealth.opacity <= 1 &&
        isBoundedString(stealth.processTitle, 0, 120);
    }

    function isValidBufferSummaryItem(item) {
      let itemKeys = ['id', 'type', 'label', 'preview', 'createdAt'];
      return isValidMapKeys(item, itemKeys, itemKeys) &&
        isBoundedString(item.id, 1, 128) &&
        item.type is string &&
        item.type in ['screenshot', 'text', 'audio', 'code'] &&
        isBoundedString(item.label, 0, 200) &&
        isBoundedString(item.preview, 0, 2000) &&
        isValidEpochMs(item.createdAt);
    }

    function isValidMessageItem(msg) {
      let requiredKeys = ['id', 'role', 'mode', 'content', 'timestamp'];
      let allowedKeys = ['id', 'role', 'mode', 'content', 'timestamp', 'providerUsed'];
      return isValidMapKeys(msg, requiredKeys, allowedKeys) &&
        isBoundedString(msg.id, 1, 128) &&
        msg.role is string &&
        msg.role in ['user', 'assistant'] &&
        isValidAIMode(msg.mode) &&
        isBoundedString(msg.content, 0, 200000) &&
        isValidEpochMs(msg.timestamp) &&
        (!('providerUsed' in msg) || isBoundedString(msg.providerUsed, 0, 120));
    }

    function isValidRemoteSession(data, sessionId) {
      let sessionFields = [
        'sessionId',
        'updatedAt',
        'activeMode',
        'isStreaming',
        'isListening',
        'stealth',
        'activeProvider',
        'activeModel',
        'bufferSummary',
        'latestResponse',
        'messages',
        'liveTranscript',
        'debriefReport'
      ];
      return hasRequiredFields(sessionFields) &&
        hasOnlyAllowedFields(sessionFields) &&
        isValidSessionId(data.sessionId) &&
        data.sessionId == sessionId &&
        isValidEpochMs(data.updatedAt) &&
        isValidAIMode(data.activeMode) &&
        data.isStreaming is bool &&
        data.isListening is bool &&
        isValidStealthConfig(data.stealth) &&
        isBoundedString(data.activeProvider, 0, 64) &&
        isBoundedString(data.activeModel, 0, 120) &&
        isValidList(data.bufferSummary, 30) &&
        (data.bufferSummary.size() == 0 ||
          (isValidBufferSummaryItem(data.bufferSummary[0]) &&
           isValidBufferSummaryItem(data.bufferSummary[data.bufferSummary.size() - 1]))) &&
        isBoundedString(data.latestResponse, 0, 200000) &&
        isValidList(data.messages, 100) &&
        (data.messages.size() == 0 ||
          (isValidMessageItem(data.messages[0]) &&
           isValidMessageItem(data.messages[data.messages.size() - 1]))) &&
        isBoundedString(data.liveTranscript, 0, 100000) &&
        isBoundedString(data.debriefReport, 0, 200000);
    }

    function isValidRemoteCommand(data) {
      let requiredFields = ['id', 'type', 'createdAt'];
      let allowedFields = ['id', 'type', 'payload', 'createdAt'];
      let allowedTypes = [
        'CAPTURE_SCREENSHOT',
        'CAPTURE_CLIPBOARD',
        'TOGGLE_AUDIO',
        'ASK_AI',
        'FOLLOW_UP',
        'LIVE_COACH',
        'DEBRIEF',
        'HIDE_DESKTOP',
        'TOGGLE_GHOST_MODE',
        'CLEAR_BUFFER',
        'SWITCH_MODEL'
      ];
      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        isBoundedString(data.id, 1, 128) &&
        data.type is string &&
        data.type in allowedTypes &&
        (!('payload' in data) || isBoundedString(data.payload, 0, 4000)) &&
        isValidEpochMs(data.createdAt);
    }

    function isValidPlatformDebrief(data) {
      let fields = ['userId', 'sessionTag', 'reportMarkdown', 'createdAt'];
      return hasRequiredFields(fields) &&
        hasOnlyAllowedFields(fields) &&
        isBoundedString(data.userId, 1, 128) &&
        isOwner(data.userId) &&
        isBoundedString(data.sessionTag, 0, 120) &&
        isBoundedString(data.reportMarkdown, 1, 200000) &&
        isValidEpochMs(data.createdAt);
    }

    // ===============================================================
    // Collection Match Rules — NovuJobs (Existing Shared Project)
    // ===============================================================

    match /users/{userId} {
      // User profile subcollection document: /users/{userId}/data/profile
      match /data/profile {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                        isValidProfile(request.resource.data) &&
                        canCreateProfile(request.resource.data);
        allow update: if isOwner(userId) &&
                        isValidProfile(request.resource.data) &&
                        canUpdateProfile(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // User search cycles document: /users/{userId}/data/cycles
      match /data/cycles {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // User jobs subcollection: /users/{userId}/jobs/{jobId}
      match /jobs/{jobId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                        isValidJob(request.resource.data, jobId);
        allow update: if isOwner(userId) &&
                        isValidJob(request.resource.data, jobId) &&
                        isJobUpdateImmutable(resource.data, request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    // ===============================================================
    // Collection Match Rules — CTRL Orange
    // ===============================================================

    // Desktop <-> Phone Mobile Mirror sync state (QR-paired by secret sessionId).
    // Collection listing is disabled to prevent enumerating active session codes.
    match /remote_sessions/{sessionId} {
      allow get: if isValidSessionId(sessionId);
      allow list: if false;
      allow create: if isValidSessionId(sessionId) &&
        isValidRemoteSession(request.resource.data, sessionId);
      allow update: if isValidSessionId(sessionId) &&
        isValidRemoteSession(request.resource.data, sessionId) &&
        areImmutableFieldsUnchanged(['sessionId']);
      allow delete: if false;

      // Append-only remote commands sent from Phone Remote to Desktop listener.
      match /commands/{commandId} {
        allow get, list: if isValidSessionId(sessionId);
        allow create: if isValidSessionId(sessionId) &&
          isBoundedString(commandId, 1, 128) &&
          isValidRemoteCommand(request.resource.data);
        allow update, delete: if false;
      }
    }

    // Authenticated user-owned post-session debrief records.
    match /platform_debriefs/{debriefId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isBoundedString(debriefId, 1, 128) &&
        isValidPlatformDebrief(request.resource.data);
      allow update: if isOwner(resource.data.userId) &&
        isValidPlatformDebrief(request.resource.data) &&
        areImmutableFieldsUnchanged(['userId', 'createdAt']);
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
