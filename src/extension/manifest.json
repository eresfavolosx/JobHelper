{
    "manifest_version": 3,
    "name": "Job Tracker Helper",
    "version": "1.0",
    "description": "One-click save to your local Job Tracker.",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://localhost:3000/*",
        "https://jobhelper-c3cd7.web.app/*"
    ],
    "action": {
        "default_popup": "popup.html"
    }
}