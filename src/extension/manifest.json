{
    "manifest_version": 3,
    "name": "Job Tracker Helper",
    "version": "1.0",
    "description": "One-click save to your local Job Tracker.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "action": {
        "default_popup": "popup.html"
    }
}