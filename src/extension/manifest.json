{
    "manifest_version": 3,
    "name": "NovuJobs - AI Job Tracker",
    "version": "1.1",
    "description": "One-click save jobs to NovuJobs.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "action": {
        "default_popup": "popup.html"
    }
}