{
  "openapi": "3.0.3",
  "info": {
    "title": "NovuJobs Career Command Center API",
    "description": "Secure API actions for ChatGPT to inspect, track, search, and update job applications inside NovuJobs.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://jobhelper.novu.works/api/mcp",
      "description": "Production NovuJobs Cloud Endpoint"
    }
  ],
  "paths": {
    "/summary": {
      "get": {
        "operationId": "getPipelineSummary",
        "summary": "Get pipeline status summary",
        "description": "Returns counts of jobs across wishlist, applied, screening, interviewing, and offer stages, plus ghost alerts.",
        "responses": {
          "200": {
            "description": "Pipeline summary returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineSummary"
                }
              }
            }
          }
        }
      }
    },
    "/jobs": {
      "get": {
        "operationId": "listJobs",
        "summary": "List tracked job applications",
        "description": "Returns list of tracked jobs with status, company, role, salary, and dates. Can be filtered by stage.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by stage (wishlist, applied, screening, interviewing, offer, accepted, rejected, archived)",
            "schema": {
              "type": "string",
              "enum": ["all", "wishlist", "applied", "screening", "interviewing", "offer", "accepted", "rejected", "archived"]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of applications to return (default 25)",
            "schema": {
              "type": "integer",
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Applications list returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobsListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/search": {
      "get": {
        "operationId": "searchJobs",
        "summary": "Search applications by keyword",
        "description": "Searches for matching roles across company names, job titles, locations, and application notes.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Keyword to search for",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobsSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/add": {
      "post": {
        "operationId": "addJobApplication",
        "summary": "Track a new job application",
        "description": "Creates a new application entry on the user's board with role, company, stage, salary, location, and notes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewJobPayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job application created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobItem"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/update": {
      "patch": {
        "operationId": "updateJobApplication",
        "summary": "Update an existing job application",
        "description": "Updates stage status (e.g. moving to interviewing or offer), notes, salary, or location.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateJobPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job application updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobItem"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/follow-up": {
      "post": {
        "operationId": "logJobFollowUp",
        "summary": "Log recruiter follow-up outreach",
        "description": "Records an outreach email or message sent to recruiter, updating the last contact date and resetting ghost alerts.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FollowUpPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Follow-up logged successfully"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Token",
        "description": "Enter your NovuJobs personal API token from your Profile settings."
      }
    },
    "schemas": {
      "PipelineSummary": {
        "type": "object",
        "properties": {
          "totalActiveApplications": { "type": "integer" },
          "pipelineStages": {
            "type": "object",
            "properties": {
              "wishlist": { "type": "integer" },
              "applied": { "type": "integer" },
              "screening": { "type": "integer" },
              "interviewing": { "type": "integer" },
              "offer": { "type": "integer" },
              "accepted": { "type": "integer" },
              "rejected": { "type": "integer" }
            }
          },
          "urgentAlerts": {
            "type": "object",
            "properties": {
              "ghostAlertsCount": { "type": "integer" },
              "followUpDueCount": { "type": "integer" }
            }
          }
        }
      },
      "JobItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "company": { "type": "string" },
          "role": { "type": "string" },
          "status": { "type": "string" },
          "salary": { "type": "string" },
          "location": { "type": "string" },
          "url": { "type": "string" },
          "notes": { "type": "string" },
          "createdAt": { "type": "string" },
          "lastFollowUpAt": { "type": "string" }
        }
      },
      "JobsListResponse": {
        "type": "object",
        "properties": {
          "totalMatching": { "type": "integer" },
          "returned": { "type": "integer" },
          "jobs": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/JobItem" }
          }
        }
      },
      "JobsSearchResponse": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "matchCount": { "type": "integer" },
          "results": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/JobItem" }
          }
        }
      },
      "NewJobPayload": {
        "type": "object",
        "required": ["company", "role"],
        "properties": {
          "company": { "type": "string" },
          "role": { "type": "string" },
          "status": { "type": "string", "default": "applied" },
          "salary": { "type": "string" },
          "location": { "type": "string" },
          "url": { "type": "string" },
          "notes": { "type": "string" }
        }
      },
      "UpdateJobPayload": {
        "type": "object",
        "required": ["jobId"],
        "properties": {
          "jobId": { "type": "string" },
          "status": { "type": "string" },
          "notes": { "type": "string" },
          "salary": { "type": "string" },
          "location": { "type": "string" }
        }
      },
      "FollowUpPayload": {
        "type": "object",
        "required": ["jobId", "note"],
        "properties": {
          "jobId": { "type": "string" },
          "channel": { "type": "string", "default": "email" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
